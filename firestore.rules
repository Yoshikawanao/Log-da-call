rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Perfis: qualquer pessoa logada pode ler (necessário para adicionar por e-mail);
    // cada pessoa só escreve o próprio perfil.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid;
    }

    // Grupos: só membros enxergam.
    match /groups/{gid} {
      allow read: if request.auth != null
                  && request.auth.uid in resource.data.memberIds;

      allow create: if request.auth != null
                    && request.resource.data.ownerId == request.auth.uid
                    && request.auth.uid in request.resource.data.memberIds;

      // O dono pode alterar o grupo (adicionar/remover membros).
      // Um membro comum só pode sair do grupo (remover a si mesmo).
      allow update: if request.auth != null && (
        resource.data.ownerId == request.auth.uid
        || (
          request.auth.uid in resource.data.memberIds
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
          && request.resource.data.memberIds.toSet().difference(resource.data.memberIds.toSet()).size() == 0
          && resource.data.memberIds.toSet().difference(request.resource.data.memberIds.toSet()).hasOnly([request.auth.uid])
        )
      );

      // Calls (etapa 2): qualquer membro lê e escreve.
      match /calls/{callId} {
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/groups/$(gid)).data.memberIds;
      }
    }
  }
}
